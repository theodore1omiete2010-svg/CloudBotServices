// ============================================
// CBS - CLOUDBOTSERVICES
// DATABASE SCHEMA v3
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
  PAYG
}

enum OfferingType {
  PRODUCT
  SERVICE
  FOOD
  DRINK
  PACKAGE
}

enum ConversationStatus {
  ACTIVE
  WAITING_HUMAN
  RESOLVED
  CLOSED
}

enum MessageSender {
  CUSTOMER
  BOT
  HUMAN
}

enum MessageType {
  TEXT
  IMAGE
  BUTTON
  INTERACTIVE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
  WEBCHAT
  INSTAGRAM
  MESSENGER
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  DIRECT_BANK_TRANSFER
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  AUTO_CONFIRMED
  MANUAL_CONFIRMED
  REJECTED
  FAILED
}

enum LeadType {
  ENQUIRY
  FOLLOWUP
  POTENTIAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum NotificationType {
  NEW_ORDER
  NEW_MESSAGE
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  HANDOFF_REQUEST
  LEAD_CAPTURED
  LOW_STOCK
  SYSTEM
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================
// USER
// ============================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  password      String?    // null for pending invited users
  name          String
  country       String?
  status        UserStatus @default(ACTIVE)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships   BusinessMembership[]
  invitationsSent BusinessInvitation[] @relation("InvitationSender")
  sessions      Session[]
  verificationCodes VerificationCode[]
  passwordResetTokens PasswordResetToken[]
}

// ============================================
// BUSINESS
// ============================================

model Business {
  id                 String   @id @default(cuid())
  name               String
  email              String
  phone              String?
  address            String?
  businessType       String?

  logoUrl            String?
  currency           String   @default("NGN")
  timezone           String   @default("Africa/Lagos")

  // Customer payment bank details
  bankName           String?
  accountNumber      String?
  accountName        String?

  // Subscription summary
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?

  // Legacy/simple channel summary
  activeChannels     String[] @default([])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships        BusinessMembership[]
  invitations        BusinessInvitation[]

  subscription       Subscription?

  offerings          Offering[]
  faqs               FAQ[]

  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]

  orders             Order[]
  payments           Payment[]

  leads              Lead[]
  notifications      Notification[]

  channelConnections ChannelConnection[]
  botConfiguration   BotConfiguration?
  settings           BusinessSettings?

  broadcasts         Broadcast[]
  analyticsSnapshots AnalyticsSnapshot[]
}

// ============================================
// BUSINESS MEMBERSHIP
// Allows one user to belong to multiple businesses
// ============================================

model BusinessMembership {
  id          String         @id @default(cuid())
  role        MembershipRole @default(STAFF)
  status      UserStatus     @default(ACTIVE)

  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, businessId])
  @@index([businessId])
}

// ============================================
// BUSINESS INVITATION
// ============================================

model BusinessInvitation {
  id            String           @id @default(cuid())
  email         String
  name          String?
  role          MembershipRole   @default(AGENT)

  token         String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?

  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invitedById   String?
  invitedBy     User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt     DateTime         @default(now())

  @@index([businessId])
  @@index([email])
}

// ============================================
// SESSION
// ============================================

model Session {
  id           String   @id @default(cuid())
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// EMAIL / VERIFICATION CODES
// ============================================

model VerificationCode {
  id          String   @id @default(cuid())
  code        String
  purpose     String   // signup, email_verification, phone_verification
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int      @default(0)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId, purpose])
}

// ============================================
// PASSWORD RESET
// ============================================

model PasswordResetToken {
  id          String   @id @default(cuid())
  token       String   @unique
  expiresAt   DateTime
  usedAt      DateTime?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
}

// ============================================
// SUBSCRIPTION
// ============================================

model Subscription {
  id                    String               @id @default(cuid())

  planCode              String               // trial, starter, growth, business, payg
  status                SubscriptionStatus   @default(TRIAL)
  interval              SubscriptionInterval @default(MONTHLY)

  amount                Decimal              @db.Decimal(12, 2)
  currency              String               @default("NGN")

  provider              String?
  externalSubscriptionId String?             @unique

  startedAt             DateTime?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  trialEndsAt           DateTime?
  cancelledAt           DateTime?

  businessId            String               @unique
  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

// ============================================
// BUSINESS SETTINGS
// ============================================

model BusinessSettings {
  id                    String   @id @default(cuid())

  notificationsEnabled  Boolean  @default(true)
  emailNotifications    Boolean  @default(true)
  orderNotifications    Boolean  @default(true)
  paymentNotifications  Boolean  @default(true)
  leadNotifications     Boolean  @default(true)

  autoReplyEnabled      Boolean  @default(true)
  humanHandoffEnabled   Boolean  @default(true)

  settings              Json?

  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================
// BOT CONFIGURATION
// ============================================

model BotConfiguration {
  id                    String   @id @default(cuid())

  enabled               Boolean  @default(true)
  botName               String?
  greetingMessage       String?
  fallbackMessage       String?
  handoffMessage        String?

  averageResponseTimeMs Int?
  csatScore             Float?

  settings              Json?

  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================
// CHANNEL CONNECTION
// ============================================

model ChannelConnection {
  id              String      @id @default(cuid())

  channel         ChannelType
  connected       Boolean     @default(false)
  displayName     String?
  externalAccountId String?

  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?

  metadata        Json?

  businessId      String
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([businessId, channel])
}

// ============================================
// OFFERING
// ============================================

model Offering {
  id                String       @id @default(cuid())
  name              String
  description       String?

  type              OfferingType @default(PRODUCT)
  category          String?

  price             Decimal?     @db.Decimal(12, 2)
  currency          String       @default("NGN")

  isAvailable       Boolean      @default(true)

  trackStock        Boolean      @default(false)
  stock             Int?
  lowStockThreshold Int?

  imageUrl          String?

  metadata          Json?

  businessId        String
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orderItems        OrderItem[]

  @@unique([businessId, name])
  @@index([businessId, category])
}

// ============================================
// FAQ
// ============================================

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String?

  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, category])
}

// ============================================
// CUSTOMER
// ============================================

model Customer {
  id                    String   @id @default(cuid())
  phone                 String
  name                  String?
  email                 String?

  status                String   @default("active")
  lastContactAt         DateTime?

  trustScore            Int      @default(0)
  totalOrders           Int      @default(0)
  verifiedPayments      Int      @default(0)
  failedVerifications   Int      @default(0)

  notes                 String?
  metadata              Json?

  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  conversations         Conversation[]
  orders                Order[]
  payments              Payment[]
  leads                 Lead[]
  broadcastRecipients  BroadcastRecipient[]

  @@unique([businessId, phone])
  @@index([businessId, status])
  @@index([businessId, lastContactAt])
}

// ============================================
// CONVERSATION
// ============================================

model Conversation {
  id              String             @id @default(cuid())

  status          ConversationStatus @default(ACTIVE)
  resolvedBy      MessageSender?
  handoffAt       DateTime?

  channel         ChannelType        @default(WHATSAPP)

  subject         String?
  lastMessageAt   DateTime?
  unreadCount     Int                @default(0)

  assignedToId    String?

  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId      String
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  messages        Message[]

  @@index([businessId, status])
  @@index([businessId, channel])
  @@index([customerId])
}

// ============================================
// MESSAGE
// ============================================

model Message {
  id              String       @id @default(cuid())

  content         String
  sender          MessageSender
  messageType     MessageType   @default(TEXT)
  channel         ChannelType  @default(WHATSAPP)

  externalId      String?      @unique
  metadata        Json?
  isRead          Boolean      @default(false)

  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  businessId      String
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt       DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([businessId, createdAt])
}

// ============================================
// ORDER
// ============================================

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique

  status                OrderStatus @default(PENDING)

  subtotal              Decimal     @db.Decimal(12, 2)
  deliveryFee           Decimal     @default(0) @db.Decimal(12, 2)
  discount              Decimal     @default(0) @db.Decimal(12, 2)
  total                 Decimal     @db.Decimal(12, 2)

  currency              String      @default("NGN")

  deliveryDetails      Json?
  pickupTime            String?
  notes                 String?

  orderDate             DateTime    @default(now())
  expectedDeliveryDate  DateTime?

  businessId            String
  business              Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]
  payment               Payment?

  @@index([businessId, status])
  @@index([businessId, orderDate])
  @@index([customerId])
}

// ============================================
// ORDER ITEM
// ============================================

model OrderItem {
  id          String   @id @default(cuid())

  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)

  itemName    String
  notes       String?

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  offeringId  String
  offering    Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())

  @@index([orderId])
}

// ============================================
// PAYMENT
// ============================================

model Payment {
  id                String        @id @default(cuid())

  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("NGN")

  method            PaymentMethod @default(DIRECT_BANK_TRANSFER)

  bankName          String?
  accountNumber     String?
  transactionId     String?
  transactionDate   DateTime?
  paymentProof      String?

  status            PaymentStatus @default(PENDING)
  confidence        String?
  verifiedAt        DateTime?
  verifiedBy        String?

  rawData           Json?

  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// ============================================
// LEAD
// ============================================

model Lead {
  id          String     @id @default(cuid())

  type        LeadType   @default(ENQUIRY)
  notes       String?
  status      LeadStatus @default(NEW)

  source      String?
  lastContactAt DateTime?
  convertedAt DateTime?

  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// ============================================
// NOTIFICATION
// ============================================

model Notification {
  id          String           @id @default(cuid())

  type        NotificationType
  title       String
  content     String

  read        Boolean          @default(false)
  readAt      DateTime?

  metadata    Json?

  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())

  @@index([businessId, read])
  @@index([businessId, createdAt])
}

// ============================================
// BROADCAST
// ============================================

model Broadcast {
  id                String          @id @default(cuid())

  title             String
  message           String

  channel           ChannelType
  status             BroadcastStatus @default(DRAFT)

  audienceFilter    Json?

  recipientsCount   Int             @default(0)
  sentCount         Int             @default(0)
  deliveredCount    Int             @default(0)
  readCount         Int             @default(0)
  failedCount       Int             @default(0)

  scheduledAt       DateTime?
  sentAt             DateTime?

  businessId        String
  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  recipients        BroadcastRecipient[]

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

// ============================================
// BROADCAST RECIPIENT
// ============================================

model BroadcastRecipient {
  id            String                    @id @default(cuid())

  status        BroadcastRecipientStatus @default(PENDING)
  externalId    String?
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?

  broadcastId   String
  broadcast     Broadcast                 @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  customerId    String
  customer      Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, customerId])
  @@index([broadcastId, status])
}

// ============================================
// ANALYTICS SNAPSHOT
// ============================================
// Gives the Analytics page reliable historical data.

model AnalyticsSnapshot {
  id                    String   @id @default(cuid())

  date                  DateTime

  customers             Int      @default(0)
  newCustomers          Int      @default(0)

  conversations         Int      @default(0)
  botHandled            Int      @default(0)
  humanHandoffs         Int      @default(0)

  orders                Int      @default(0)
  revenue               Decimal  @default(0) @db.Decimal(14, 2)

  leads                 Int      @default(0)
  convertedLeads        Int      @default(0)

  payments              Int      @default(0)
  successfulPayments    Int      @default(0)

  averageResponseTimeMs Int?
  csatScore             Float?

  businessId            String
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt             DateTime @default(now())

  @@unique([businessId, date])
  @@index([businessId, date])
}
